{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "bake:character": "node scripts/bake-character.mjs",
    "bake:playable": "node scripts/bake-playable.mjs",
    "bake:static": "node scripts/bake-static-models.mjs",
    "bake:polish": "node scripts/bake-central-detail.mjs",
    "test:polish": "node --test tests/ui-commercial-mobility.test.mjs",
    "prebuild": "npm run bake:static",
    "typecheck": "tsc --noEmit --incremental false",
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "node scripts/build-verified.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test:ci": "node scripts/test-current.mjs",
    "test:legacy": "node --test tests/*.test.mjs",
    "test": "npm run build && npm run test:ci",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "measure:playable": "node scripts/measure-playable-loading.mjs",
    "qa:capture": "node scripts/run-visual-qa.mjs",
    "fetch:character": "node scripts/fetch-character-upstream.mjs",
    "convert:character": "node scripts/convert-character.mjs",
    "fetch:audio": "node scripts/fetch-audio-upstream.mjs",
    "convert:audio": "node scripts/convert-audio.mjs",
    "fetch:textures": "node scripts/fetch-texture-upstream.mjs",
    "convert:textures": "node scripts/convert-textures.mjs",
    "analyse:gait": "node scripts/analyse-gait.mjs",
    "bake:crowd-hq": "node scripts/bake-crowd-hq.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@types/three": "^0.185.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "polygon-clipping": "^0.15.7",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@cloudflare/vite-plugin": "1.61.0",
    "@cloudflare/workers-types": "5.20260927.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.1",
    "wrangler": "4.142.0"
  },
  "type": "module",
  "overrides": {
    "vinext": {
      "image-size": "2.0.4"
    }
  }
}
